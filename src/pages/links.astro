---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import LinkRow from '../components/LinkRow.astro';
import { LINKS, RELEASES } from '../data/links';
import type { LinkItem } from '../data/links';

const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
const fmtDate = (d: Date) => `${MONTHS[d.getMonth()]} ${d.getDate()}`;

// upcoming pre-saves only — once a drop's date passes it lives on the
// platforms below, so it falls off the pre-save list on the next deploy.
const now = new Date();
const upcoming = RELEASES.map((r) => ({ ...r, dt: new Date(`${r.date}T00:00:00`) }))
  .filter((r) => r.dt > now)
  .sort((a, b) => a.dt.getTime() - b.dt.getTime());

const presaveItems: LinkItem[] = upcoming.map((r, i) => ({
  label: r.title,
  href: r.href,
  icon: 'star',
  featured: i === 0, // soonest drop highlighted
  note: `pre-save · ${fmtDate(r.dt)}`,
}));
---

<Base title="links" description="every place to hear the cyphering — spotify, apple music, soundcloud, suno, youtube.">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col items-center px-6 py-16">
    <Wordmark size="sm" href="/" />

    <div class="mt-12 flex w-full flex-col gap-3">
      {presaveItems.map((item) => <LinkRow item={item} />)}

      {presaveItems.length > 0 && (
        <div class="my-2 flex items-center gap-3 text-[var(--color-ink-faint)]">
          <span class="h-px flex-1 bg-[var(--color-line)]"></span>
          <span class="font-mono text-[0.65rem] uppercase tracking-[0.3em]">listen</span>
          <span class="h-px flex-1 bg-[var(--color-line)]"></span>
        </div>
      )}

      {LINKS.map((item) => <LinkRow item={item} />)}
    </div>

    <footer class="mt-auto pt-16 text-center">
      <a href="/" class="font-mono text-xs tracking-[0.2em] text-[var(--color-ink-faint)] transition-colors hover:text-[var(--color-ink-dim)]">
        &larr; about the cyphering
      </a>
    </footer>
  </main>
</Base>
