---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import LinkRow from '../components/LinkRow.astro';
import { LINKS, RELEASES } from '../data/links';
import type { LinkItem } from '../data/links';

const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
const fmtDate = (d: Date) => `${MONTHS[d.getMonth()]} ${d.getDate()}`;

// upcoming pre-saves only — once a drop's date passes it lives on the
// platforms column, so it falls off the pre-save list on the next deploy.
const now = new Date();
const upcoming = RELEASES.map((r) => ({ ...r, dt: new Date(`${r.date}T00:00:00`) }))
  .filter((r) => r.dt > now)
  .sort((a, b) => a.dt.getTime() - b.dt.getTime());

const presaveItems: LinkItem[] = upcoming.map((r, i) => ({
  label: r.title,
  href: r.href,
  icon: 'star',
  featured: i === 0, // soonest drop highlighted
  note: `pre-save · ${fmtDate(r.dt)}`,
}));

const hasPresaves = presaveItems.length > 0;
---

<Base title="links" description="every place to hear the cyphering — spotify, apple music, soundcloud, suno, youtube.">
  <main
    class:list={[
      'mx-auto flex min-h-dvh w-full flex-col items-center px-6 py-16',
      hasPresaves ? 'max-w-3xl' : 'max-w-md',
    ]}
  >
    <Wordmark size="sm" href="/" />

    <div
      class:list={[
        'mt-14 grid w-full grid-cols-1 gap-x-10 gap-y-12',
        hasPresaves && 'sm:grid-cols-2 sm:items-start',
      ]}
    >
      {
        hasPresaves && (
          <section class="flex flex-col gap-3">
            <h2 class="mb-1 border-b border-[var(--color-line)] pb-2 font-mono text-[0.65rem] uppercase tracking-[0.3em] text-[var(--color-ink-faint)]">
              pre-save
            </h2>
            {presaveItems.map((item) => (
              <LinkRow item={item} />
            ))}
          </section>
        )
      }

      <section class="flex flex-col gap-3">
        <h2 class="mb-1 border-b border-[var(--color-line)] pb-2 font-mono text-[0.65rem] uppercase tracking-[0.3em] text-[var(--color-ink-faint)]">
          music
        </h2>
        {LINKS.map((item) => <LinkRow item={item} />)}
      </section>
    </div>

    <footer class="mt-auto pt-16 text-center">
      <a href="/" class="font-mono text-xs tracking-[0.2em] text-[var(--color-ink-faint)] transition-colors hover:text-[var(--color-ink-dim)]">
        &larr; about the cyphering
      </a>
    </footer>
  </main>
</Base>
