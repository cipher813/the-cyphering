---
import Base from '../layouts/Base.astro';
---

<Base>
  <section class="flex flex-1 flex-col items-center justify-center py-12 text-center">
    <div class="max-w-lg space-y-4 text-balance text-lg leading-relaxed text-[var(--color-ink-dim)]">
      <p>
        everything you are made of was forged in a dying star, and will be scattered
        into infinite others. the cyphering is the soundtrack for the parts in between.
      </p>
      <p>
        not background music. the cyphering turns the deepest questions
        &mdash; reality, the cosmos, the self &mdash; into something you can
        lose yourself to at full volume.
      </p>
    </div>

    <div class="mt-10 flex flex-col items-center gap-2">
      <p class="font-mono text-xs tracking-[0.2em] text-[var(--color-ink-faint)]">
        created with AI
      </p>
      <p class="max-w-md font-mono text-xs leading-relaxed tracking-[0.2em] text-[var(--color-ink-faint)]">
        psytrance · hardstyle · drum and bass · progressive trance · melodic techno
      </p>
    </div>
  </section>
</Base>
