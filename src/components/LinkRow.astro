---
import { Icon } from 'astro-icon/components';
import type { LinkItem } from '../data/links';

interface Props {
  item: LinkItem;
}
const { item } = Astro.props;
const featured = item.featured ?? false;
---

<a
  href={item.href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'group relative flex items-center gap-4 rounded-2xl border px-5 py-4 transition-all duration-200',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
    featured
      ? 'border-[color-mix(in_oklab,var(--color-accent)_45%,transparent)] bg-[color-mix(in_oklab,var(--color-accent)_12%,transparent)] hover:bg-[color-mix(in_oklab,var(--color-accent)_18%,transparent)]'
      : 'border-[var(--color-line)] bg-[color-mix(in_oklab,var(--color-bg-soft)_70%,transparent)] hover:border-[color-mix(in_oklab,var(--color-accent)_40%,transparent)] hover:bg-[var(--color-bg-soft)]',
  ]}
>
  <span
    class:list={[
      'flex size-9 shrink-0 items-center justify-center rounded-xl',
      featured ? 'text-[var(--color-accent-soft)]' : 'text-[var(--color-ink-dim)] group-hover:text-[var(--color-ink)]',
    ]}
  >
    {
      item.icon === 'star' ? (
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
          <path d="M12 2l2.9 6.26L22 9.27l-5 4.73L18.18 21 12 17.27 5.82 21 7 14l-5-4.73 7.1-1.01L12 2z" />
        </svg>
      ) : (
        <Icon name={`simple-icons:${item.icon}`} class="size-5" />
      )
    }
  </span>

  <span class="flex flex-1 flex-col">
    <span class="text-[0.95rem] tracking-wide text-[var(--color-ink)]">{item.label}</span>
    {item.note && <span class="text-xs tracking-wide text-[var(--color-ink-faint)]">{item.note}</span>}
  </span>

  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    class="size-4 shrink-0 text-[var(--color-ink-faint)] transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-[var(--color-ink-dim)]"
    aria-hidden="true"
  >
    <path d="M7 17L17 7M17 7H9M17 7v8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
