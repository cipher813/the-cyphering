---
// the cyphering wordmark + the breathing dot row from the design.
interface Props {
  /** size of the wordmark */
  size?: 'sm' | 'lg';
  href?: string;
}
const { size = 'lg', href } = Astro.props;
const Tag = href ? 'a' : 'div';
const text =
  size === 'lg'
    ? 'text-3xl sm:text-4xl tracking-[0.18em]'
    : 'text-base tracking-[0.22em]';
---

<Tag
  href={href}
  class:list={[
    'inline-flex flex-col items-center gap-3 select-none',
    href && 'transition-opacity hover:opacity-80',
  ]}
>
  <span class:list={['font-mono font-light text-[var(--color-ink)]', text]}>
    the cyphering
  </span>
  <span class="dot-pulse flex items-center gap-2 text-[var(--color-accent)]" aria-hidden="true">
    {Array.from({ length: 7 }).map(() => <span class="size-1 rounded-full bg-current"></span>)}
  </span>
</Tag>
