---
import { Icon } from 'astro-icon/components';
import Wordmark from './Wordmark.astro';
import { LINKS } from '../data/links';

// single-page hub: the wordmark + the platform links (these replace the old
// about/listen/links page menu — there are no sub-pages anymore).
---

<header class="flex flex-col items-center px-6 pt-16 text-center">
  <Wordmark size="lg" href="/" />

  <nav class="mt-8 flex flex-wrap items-center justify-center gap-6">
    {
      LINKS.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={l.label}
          class="text-[var(--color-ink-dim)] transition-colors duration-200 hover:text-[var(--color-ink)]"
        >
          {l.icon === 'suno' ? (
            // suno isn't a simple-icons glyph; draw its real "sliced egg" S-mark
            // (the official sine-wave/egg logo path) as a solid currentColor fill
            // so it sits in the same monochrome light/dark style (ink-dim → ink on
            // hover) as the rest of the row.
            <svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true">
              <path d="M16.5 0C20.642 0 24 5.373 24 12h-9c0 6.627-3.358 12-7.5 12C3.358 24 0 18.627 0 12h9c0-6.627 3.358-12 7.5-12z" />
            </svg>
          ) : (
            <Icon name={`simple-icons:${l.icon}`} class="size-6" />
          )}
        </a>
      ))
    }
  </nav>
</header>
