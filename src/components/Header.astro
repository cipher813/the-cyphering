---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Wordmark from './Wordmark.astro';
import { LINKS } from '../data/links';
import sunoLogo from '../assets/suno-logo.png';

// single-page hub: the wordmark + the platform links (these replace the old
// about/listen/links page menu — there are no sub-pages anymore).
---

<header class="flex flex-col items-center px-6 pt-16 text-center">
  <Wordmark size="lg" href="/" />

  <nav class="mt-8 flex flex-wrap items-center justify-center gap-6">
    {
      LINKS.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={l.label}
          class="group text-[var(--color-ink-dim)] transition-colors duration-200 hover:text-[var(--color-ink)]"
        >
          {l.icon === 'suno' ? (
            <Image
              src={sunoLogo}
              alt=""
              width={48}
              height={48}
              class="size-6 rounded-full opacity-85 transition-opacity duration-200 group-hover:opacity-100"
            />
          ) : (
            <Icon name={`simple-icons:${l.icon}`} class="size-6" />
          )}
        </a>
      ))
    }
  </nav>
</header>
